# Copy to .env (local) or paste into your host's variables (Railway, Render...).
# Never commit real values: this repository is public.

ENVIRONMENT=production
DATABASE_URL=postgresql://user:password@host:5432/lexos
ADMIN_TOKEN=change-me-long-random-string
DASHBOARD_TOKEN=change-me-dashboard-password

# Bird (WhatsApp)
BIRD_API_KEY=bk_eu1_xxx
BIRD_WEBHOOK_SECRET=whsec_xxx

# LLM via LiteLLM. Set the key for the provider you use.
LLM_MODEL=anthropic/claude-haiku-5-5
LLM_DRAFT_MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=   (then e.g. LLM_MODEL=openrouter/qwen/qwen3-235b-a22b)
# OPENAI_API_KEY=

# CRM: local (default) or bigin
CRM_BACKEND=local
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=com
# Optional: create Bigin Pipeline records for new matters
BIGIN_SUB_PIPELINE=
BIGIN_STAGE=

# First firm, created automatically at startup
DEFAULT_TENANT_NAME=Digital Vertise Demo Firm
DEFAULT_TENANT_SLUG=demo-firm
DEFAULT_TENANT_WHATSAPP=+971500000000
DEFAULT_TENANT_TEAM_GROUP=
DEFAULT_TENANT_TEAM_PHONES=
